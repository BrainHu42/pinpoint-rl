# Copy to .env (git-ignored). Load with: set -a; . ./.env; set +a
# OpenRouter key, only for the Gemini benchmark/labelling runs (pivot_diagnostics --api-key-env, llm_advantage label).
OPENROUTER_API_KEY=
# Load from the repo root; storage defaults in the code use these same local directories.
HF_HOME=${PWD}/data/hf
HF_HUB_CACHE=${PWD}/data/hf/hub
# Pinpoint checkout: model.zip unzipped here (contrastive checkpoint + retrieval index).
PINPOINT_ROOT=${PWD}/data/pinpoint/pinpoint-submission
