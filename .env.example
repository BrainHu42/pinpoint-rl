# Copy to .env (git-ignored). Load with: set -a; . ./.env; set +a
# OpenRouter key, only for the Gemini benchmark/labelling runs (pivot_diagnostics --api-key-env, llm_advantage label).
OPENROUTER_API_KEY=
# Hugging Face cache; model and dataset paths in the code assume /data/hf.
HF_HOME=/data/hf
HF_HUB_CACHE=/data/hf/hub
# Pinpoint submission checkout (contrastive checkpoint + retrieval index).
PINPOINT_ROOT=/home/brian/workspace/pinpoint-submission/submission
